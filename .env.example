# =============================================
# 量子科技人才展示网站 — 环境变量示例
# =============================================
# 复制本文件为 .env.local（本地开发）或配置到部署平台环境变量中。
# 注意：本文件只包含变量名与说明，不包含任何真实值。

# ── Supabase（必填）────────────────────────────
# Supabase 项目 URL（形如 https://xxxxxxxx.supabase.co）
# 获取位置：Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 公开密钥（Publishable / anon key）
# 本项目仅使用公开密钥，不使用 Service Role Key / Secret Key。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 服务运行时（由平台注入，一般无需手动配置）────
# 服务监听端口（Coze 沙箱自动注入，默认 5000）
DEPLOY_RUN_PORT=5000

# 对外访问域名（Coze 沙箱自动注入，用于 SEO metadataBase）
COZE_PROJECT_DOMAIN_DEFAULT=

# 环境标识：DEV / PROD（Coze 沙箱自动注入）
COZE_PROJECT_ENV=DEV
